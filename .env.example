PROJECT_NAME=ClinVision AI
API_VERSION=1.0.0
ENVIRONMENT=local

POSTGRES_DB=clinvision
POSTGRES_USER=clinvision
POSTGRES_PASSWORD=clinvision
DATABASE_URL=postgresql+psycopg2://clinvision:clinvision@postgres:5432/clinvision
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=26214400
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
CONVERTED_DIR=/app/data/converted
HEATMAP_DIR=/app/data/heatmaps

CELERY_TASK_TIME_LIMIT_SECONDS=180
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=150
CELERY_RESULT_EXPIRES_SECONDS=3600
REDIS_TASK_TTL_SECONDS=3600

MODEL_NAME=DenseNet121
MODEL_VERSION=densenet121-v1.0.0-demo
MODEL_CHECKPOINT_PATH=
MODEL_HASH=demo-unvalidated

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=8

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_POLL_TIMEOUT_MS=180000

